    "proxy": "node --import tsx src/proxy.ts",
    "mcp": "node --import tsx src/mcp/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "binaryen": "123.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "near-api-js": "^7.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "bin": {
    "siege-mcp": "bin/siege-mcp.mjs"
  }
}
