{
  "name": "siege",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "SIEGE: can your AI wallet be drained? Mandate guard + attack engine + eval harness for OutLayer agent wallets.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "eval": "node --import tsx src/eval/run.ts",
    "oracle": "node --import tsx src/oracle.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
