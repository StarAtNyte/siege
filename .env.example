# Optional: use Claude for the ambiguous band (otherwise a scripted judge runs; no key needed)
ANTHROPIC_API_KEY=
SIEGE_LLM=0
# Hard spend cap shared by SIEGE and DARWIN, in USD
NEAR_LLM_BUDGET_USD=25
# Guard proxy. It holds the OutLayer key; the agent authenticates with SIEGE_PROXY_TOKEN and never sees the key.
SIEGE_PROXY_TOKEN=
OUTLAYER_API_KEY=
MANDATE="Pay up to 5 NEAR per transaction to alice.testnet and bob.testnet for invoices. Never spend more than 20 NEAR per day."
UPSTREAM=https://testnet-api.outlayer.ai
PORT=8687
SIEGE_STATE_DIR=.siege
# Vault mode (instead of OUTLAYER_API_KEY): see docs/ARCHITECTURE.md
# VAULT_CONTRACT=vault.you.testnet
# VAULT_NETWORK=testnet
# GUARD_KEY=ed25519:...
# VAULT_AGENT_KEY=ed25519:...
